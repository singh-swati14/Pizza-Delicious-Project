<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="Pizza_Website.SiteMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - Pizza Palace System</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- FontAwesome Icons -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <!-- Custom CSS -->
    <link href="~/CSS/site.css" rel="stylesheet" type="text/css" />

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <!-- Top Promotional Bar -->
        <div class="top-promo-bar text-center">
            <div class="container d-flex justify-content-between align-items-center">
                <span>Special Offer: Get <strong>20% OFF</strong> on your first order! Code: <strong>PIZZA20</strong></span>
                <div>
                    <span class="me-3"><i class="fas fa-phone-alt"></i> +91 98765 43210</span>
                    <a href="<%= Page.ResolveUrl("~/Admin/AdminLogin.aspx") %>" class="text-warning"><i class="fas fa-user-shield"></i> Admin Portal</a>
                </div>
            </div>
        </div>

        <!-- Header / Navbar -->
        <nav class="navbar navbar-expand-lg navbar-pizza sticky-top">
            <div class="container">
                <a class="navbar-brand" href="<%= Page.ResolveUrl("~/Home.aspx") %>">
                        Pizza Palace
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" 
                        aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4">
                        <li class="nav-item">
                            <a class="nav-link" href="<%= Page.ResolveUrl("~/Home.aspx") %>"><i class="fas fa-home me-1"></i>Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="<%= Page.ResolveUrl("~/Menu.aspx") %>"><i class="fas fa-pizza-slice me-1"></i>Menu</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="<%= Page.ResolveUrl("~/MyOrders.aspx") %>"><i class="fas fa-receipt me-1"></i>My Orders</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link cart-badge" href="<%= Page.ResolveUrl("~/Cart.aspx") %>">
                                <i class="fas fa-shopping-cart me-1"></i>Cart
                                <span class="badge rounded-pill bg-danger">3</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="<%= Page.ResolveUrl("~/About.aspx") %>"><i class="fas fa-info-circle me-1"></i>About</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="<%= Page.ResolveUrl("~/Contact.aspx") %>"><i class="fas fa-envelope me-1"></i>Contact</a>
                        </li>
                    </ul>

                    <!-- Right Side Navigation / Dynamic Auth UI -->
                    <div class="d-flex align-items-center gap-2">
                        <!-- Before Login UI -->
                        <asp:PlaceHolder ID="phAnonymous" runat="server">
                            <a href="<%= Page.ResolveUrl("~/Login.aspx") %>" class="btn btn-pizza-outline">Login</a>
                            <a href="<%= Page.ResolveUrl("~/Registration.aspx") %>" class="btn btn-pizza">Register</a>
                        </asp:PlaceHolder>

                        <!-- After User Login UI -->
                        <asp:PlaceHolder ID="phUserLoggedIn" runat="server" Visible="false">
                            <span class="fw-bold text-dark me-2">Welcome, <asp:Literal ID="litUserName" runat="server"></asp:Literal>!</span>
                            <div class="dropdown me-2">
                                <a class="btn btn-light dropdown-toggle rounded-circle p-2" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fas fa-user-circle fa-lg text-danger"></i>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow">
                                    <li><a class="dropdown-item" href="<%= Page.ResolveUrl("~/Profile.aspx") %>"><i class="fas fa-id-card me-2"></i>Profile</a></li>
                                    <li><a class="dropdown-item" href="<%= Page.ResolveUrl("~/MyOrders.aspx") %>"><i class="fas fa-history me-2"></i>My Orders</a></li>
                                    <li><a class="dropdown-item" href="<%= Page.ResolveUrl("~/User/UserDashboard.aspx") %>"><i class="fas fa-th-large me-2"></i>User Dashboard</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <asp:LinkButton ID="btnLogoutUser" runat="server" CssClass="dropdown-item text-danger" OnClick="btnLogout_Click">
                                            <i class="fas fa-sign-out-alt me-2"></i>Logout
                                        </asp:LinkButton>
                                    </li>
                                </ul>
                            </div>
                        </asp:PlaceHolder>

                        <!-- After Admin Login UI -->
                        <asp:PlaceHolder ID="phAdminLoggedIn" runat="server" Visible="false">
                            <a href="<%= Page.ResolveUrl("~/Admin/AdminDashboard.aspx") %>" class="btn btn-warning btn-sm fw-bold">
                                <i class="fas fa-tachometer-alt me-1"></i>Admin Panel
                            </a>
                            <asp:LinkButton ID="btnLogoutAdmin" runat="server" CssClass="btn btn-outline-danger btn-sm" OnClick="btnLogout_Click">
                                <i class="fas fa-sign-out-alt me-1"></i>Logout
                            </asp:LinkButton>
                        </asp:PlaceHolder>
                    </div>
                </div>
            </div>
        </nav>

        <!-- Main Content Area -->
        <main class="flex-shrink-0">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
        </main>

        <!-- Footer -->
        <footer class="py-5 mt-auto">
            <div class="container">
                <div class="row g-4">
                    <div class="col-lg-4 col-md-6">
                        <h4 class="text-white mb-3"> Pizza Palace</h4>
                        <p class="text-secondary">Serving hot, delicious, and fresh hand-tossed pizzas made with 100% real mozzarella cheese and authentic secret sauces.</p>
                    </div>
                    <div class="col-lg-2 col-md-6">
                        <h5 class="mb-3">Quick Links</h5>
                        <ul class="list-unstyled">
                            <li class="mb-2"><a href="<%= Page.ResolveUrl("~/Home.aspx") %>">Home</a></li>
                            <li class="mb-2"><a href="<%= Page.ResolveUrl("~/Menu.aspx") %>">Pizza Menu</a></li>
                            <li class="mb-2"><a href="<%= Page.ResolveUrl("~/About.aspx") %>">About Us</a></li>
                            <li class="mb-2"><a href="<%= Page.ResolveUrl("~/Contact.aspx") %>">Contact Us</a></li>
                        </ul>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <h5 class="mb-3">Dashboards</h5>
                        <ul class="list-unstyled">
                            <li class="mb-2"><a href="<%= Page.ResolveUrl("~/User/UserDashboard.aspx") %>"><i class="fas fa-angle-right me-1"></i>User Portal</a></li>
                            <li class="mb-2"><a href="<%= Page.ResolveUrl("~/Admin/AdminDashboard.aspx") %>"><i class="fas fa-angle-right me-1"></i>Admin Dashboard</a></li>
                            <li class="mb-2"><a href="<%= Page.ResolveUrl("~/Delivery/DeliveryDashboard.aspx") %>"><i class="fas fa-angle-right me-1"></i>Delivery Partner</a></li>
                        </ul>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <h5 class="mb-3">Contact Us</h5>
                        <p class="text-secondary mb-1"><i class="fas fa-map-marker-alt me-2 text-danger"></i>123 Food Street, Pizza Town, India</p>
                        <p class="text-secondary mb-1"><i class="fas fa-envelope me-2 text-danger"></i>support@pizzapalace.com</p>
                        <p class="text-secondary mb-0"><i class="fas fa-phone me-2 text-danger"></i>+91 98765 43210</p>
                    </div>
                </div>
                <hr class="border-secondary my-4">
                <div class="text-center text-secondary">
                    <small>&copy; <%= DateTime.Now.Year %> Pizza Palace Ordering System. College Project Phase 2. All rights reserved.</small>
                </div>
            </div>
        </footer>
    </form>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/bootstrap.bundle.min.js"></script>
    <!-- Custom JS -->
    <script src="<%= Page.ResolveUrl("~/Scripts/site.js") %>"></script>
</body>
</html>
