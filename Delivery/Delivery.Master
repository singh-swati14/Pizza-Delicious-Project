<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Delivery.Master.cs" Inherits="Pizza_Website.Delivery.DeliveryMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - Delivery Partner Portal</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <link href="~/CSS/site.css" rel="stylesheet" type="text/css" />

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body class="bg-light">
    <form id="form1" runat="server">
        <!-- Top Navbar -->
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top shadow-sm">
            <div class="container-fluid px-4">
                <a class="navbar-brand fw-bold fs-4 text-warning" href="<%= Page.ResolveUrl("~/Delivery/DeliveryDashboard.aspx") %>">
                    🍕 Pizza Palace <span class="badge bg-success fs-6 align-middle ms-2">Delivery Partner</span>
                </a>
                <div class="d-flex align-items-center gap-3 ms-auto">
                    <span class="text-light me-2 d-none d-md-inline"><i class="fas fa-motorcycle text-success me-1"></i> Rider: Rahul Sharma</span>
                    <a href="<%= Page.ResolveUrl("~/Login.aspx") %>" class="btn btn-outline-light btn-sm"><i class="fas fa-sign-out-alt me-1"></i> Logout</a>
                </div>
            </div>
        </nav>

        <!-- Sidebar Layout -->
        <div class="sidebar-layout">
            <!-- Sidebar -->
            <div class="sidebar">
                <div class="px-3 pb-3 border-bottom border-secondary mb-3">
                    <small class="text-uppercase text-secondary fw-bold">Delivery Menu</small>
                </div>
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link" href="<%= Page.ResolveUrl("~/Delivery/DeliveryDashboard.aspx") %>">
                            <i class="fas fa-chart-line"></i> Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="<%= Page.ResolveUrl("~/Delivery/AssignedOrders.aspx") %>">
                            <i class="fas fa-clipboard-list"></i> Assigned Orders
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="<%= Page.ResolveUrl("~/Delivery/DeliveryProfile.aspx") %>">
                            <i class="fas fa-user-cog"></i> Delivery Profile
                        </a>
                    </li>
                </ul>
            </div>

            <!-- Main Content -->
            <div class="main-dashboard-content">
                <asp:ContentPlaceHolder ID="DeliveryMainContent" runat="server">
                </asp:ContentPlaceHolder>
            </div>
        </div>
    </form>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/bootstrap.bundle.min.js"></script>
    <script src="<%= Page.ResolveUrl("~/Scripts/site.js") %>"></script>
</body>
</html>
